{
  "name": "next-server-api-debugger",
  "version": "1.0.0",
  "description": "Development-only browser console debugging for Next.js server-side fetch calls",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "bin": {
    "next-server-api-debugger": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test",
    "postinstall": "node bin/postinstall.mjs"
  },
  "keywords": [
    "nextjs",
    "debug",
    "server",
    "api",
    "fetch",
    "devtools"
  ],
  "author": "kavinkumar025",
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
