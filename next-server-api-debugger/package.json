{
  "name": "next-server-api-debugger",
  "version": "1.3.0",
  "description": "Automatically show Next.js server-side fetch requests and responses in the local browser console",
  "license": "MIT",
  "type": "module",
  "author": "kavinkumar025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kavinkumar025/next-server-api-debugger.git",
    "directory": "next-server-api-debugger"
  },
  "homepage": "https://github.com/kavinkumar025/next-server-api-debugger/tree/main/next-server-api-debugger#readme",
  "bugs": {
    "url": "https://github.com/kavinkumar025/next-server-api-debugger/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "bin": {
    "next-server-api-debugger": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test",
    "postinstall": "node bin/postinstall.mjs"
  },
  "keywords": [
    "nextjs",
    "next.js",
    "api-debugger",
    "server-side",
    "server-components",
    "app-router",
    "ssr",
    "fetch",
    "http-logging",
    "request-logging",
    "response-logging",
    "devtools",
    "debugging"
  ],
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
